---
# ===========================================================================
# AVISO — LEE ESTO ANTES DE RELLENARLO
#
# En este MVP las credenciales van EN CLARO en `deployment_engine/secrets.yml`,
# que está gitignored y debe quedar en modo 0600. Es una decisión consciente
# (funcionalidad y simplicidad por encima de seguridad) y está escrita como tal
# en el README. El token de Proxmox equivale a root y no caduca: trátalo como una
# contraseña de root.
#
# Cómo usarlo:
#     cp deployment_engine/secrets.yml.example deployment_engine/secrets.yml
#     chmod 600 deployment_engine/secrets.yml
#     $EDITOR deployment_engine/secrets.yml
#
# Los valores de abajo son RELLENO: no apuntan a ningún Proxmox real.
# ===========================================================================

# PROPÓSITO:   describe ESTE entorno: a qué nodo Proxmox llamar y con qué token.
# INVARIANTES: el token jamás se escribe en el diario (`logs/api.jsonl`); la
#              cabecera Authorization no aparece en ningún fichero del repo.
# LÍMITES:     no hay soporte de Vault, ni de variables de entorno, ni de
#              ficheros externos: el MVP lee este fichero y punto (regla 4.4).
# VER:         README.md §Decisiones conscientes; AGENTS.md §Reglas duras

# Host o IP del nodo Proxmox. El relleno no resuelve: al ejecutar contra la API
# la llamada falla y el motor lo dice en claro, que es lo honesto.
pve_nodo: "CAMBIAME"

# Nombre del NODO en Proxmox, tal y como lo conoce la API: es lo que aparece en
# `GET /nodes` y lo que va en las rutas `/nodes/<nombre>/...` (red, invitados).
# NO es el host de la URL: un nodo puede llamarse 'Proxmox' y alcanzarse por su IP.
# Si el nombre del nodo y el host coinciden (lo habitual), repite el mismo valor.
pve_nombre_nodo: "CAMBIAME"

# Puerto de la API. El estándar de Proxmox es 8006.
pve_puerto: "8006"

# Identificador del token:  <usuario>@<realm>!<nombre-del-token>
pve_token_id: "user@pve!token"

# Secreto del token.
pve_token_secreto: "CAMBIAME"

# Verificar el certificado TLS del nodo. En un Proxmox de laboratorio con
# certificado autofirmado hay que dejarlo en false, si no cada llamada falla.
pve_verificar_tls: false

# --- Acceso SSH al hipervisor: SÓLO depuración, SÓLO último recurso ---
# El motor NUNCA usa esto (regla 1: sólo API de Proxmox). Existe para que una
# persona o un agente pueda DIAGNOSTICAR lo que la API no alcanza, después de
# agotarla. Ver AGENTS.md §Depuración por SSH (último recurso).
pve_ssh_usuario: "CAMBIAME"
pve_ssh_password: "CAMBIAME"
