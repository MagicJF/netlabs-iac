#!/usr/bin/env python3
# PROPÓSITO:   el ÚNICO punto de entrada del repositorio. Resuelve el lab, comprueba
#              el entorno antes de empezar y lanza el playbook del verbo. Guarda la
#              salida humana de Ansible en `labs/<lab>/logs/ansible.log`.
# INVARIANTES: el wrapper NO llama a la API (regla 4.2): sólo valida y lanza
#              `ansible-playbook`. Tampoco EXPORTA nada (regla 4.4): no hay una sola
#              variable de entorno de configuración. Se coloca en la raíz del repo
#              antes de lanzar nada, porque `ansible.cfg` se busca en el directorio
#              actual y lanzarlo desde otro sitio correría el motor sin inventario y
#              sin filtros, EN SILENCIO: de ahí que este fichero exista.
# LÍMITES:     sólo stdlib: el wrapper tiene que funcionar aunque el resto del
#              entorno esté a medias. No decide qué desplegar; eso es la declaración.
# VER:         README.md §Cómo se usa; AGENTS.md §Mapa; docs/decisiones/0017-*.md (la
#              versión publicada y las ramas: el check `version` vive aquí)

import os
import re
import shutil
import subprocess
import sys
import time

RAIZ = os.path.dirname(os.path.abspath(__file__))
DIRECTORIO_LABS = os.path.join(RAIZ, "labs")
PLANTILLA = os.path.join(DIRECTORIO_LABS, ".plantilla")
SECRETS = os.path.join(RAIZ, "deployment_engine", "secrets.yml")
# El MISMO `secrets.yml`, pero cifrado con sops/age y SÍ versionado. Si existe y no hay
# uno en claro más nuevo, el wrapper lo descifra antes de lanzar Ansible (informe §6.6).
SECRETS_CIFRADOS = os.path.join(RAIZ, "deployment_engine", "secrets.sops.yml")
CLAVE_AGE = os.path.join(RAIZ, "deployment_engine", "age.key")
PLAYBOOKS = os.path.join(RAIZ, "deployment_engine", "playbooks")
CHECKS = os.path.join(RAIZ, "deployment_engine", "tools", "framework_check.py")
FIXTURE_VACIO = os.path.join(RAIZ, "test", "fixtures", "cluster-vacio.json")

# La versión: tres sitios que tienen que contar lo mismo (ADR 0017). Vive aquí, en el
# wrapper, porque la versión es una propiedad del REPOSITORIO y no del motor: como el
# número de antigüedad de los labs (ADR 0016), el motor no sabe en qué repositorio está.
FICHERO_VERSION = os.path.join(RAIZ, "VERSION")
FICHERO_CHANGELOG = os.path.join(RAIZ, "CHANGELOG.md")
EXPRESION_VERSION = re.compile(r"^\d+\.\d+\.\d+$")
EXPRESION_ENTRADA_CHANGELOG = re.compile(
    r"^## \[(\d+\.\d+\.\d+)\] - (\d{4}-\d{2}-\d{2})$", re.MULTILINE
)

VERBOS = ("plan", "preflight", "apply", "verify", "test", "capture", "impair", "destroy")

# Verbos que necesitan credenciales para leer el estado del mundo. `plan` no está en
# la lista a propósito: por defecto planifica contra un clúster vacío simulado, así
# que es demostrable sin credenciales. Con `--api` sí las necesita.
VERBOS_CON_API = ("preflight", "apply", "verify", "test", "capture", "impair", "destroy")

# El fichero en el que cada verbo deja su resumen humano, para imprimirlo al final.
RESUMEN_DE = {
    "plan": "plan.txt",
    "preflight": "preflight.txt",
    "apply": "ultimo-verify.txt",
    "verify": "ultimo-verify.txt",
    "test": "ultimo-test.txt",
}

AYUDA = """\
netlabs-iac — motor de despliegue en Proxmox por su API REST

    ./lab version                   la versión publicada y el último tag (`vX.Y.Z`)
    ./lab list                      labs declarados en labs/
    ./lab new <nombre>              scaffoldea labs/NN_<nombre>/ desde labs/.plantilla/;
                                    el NN es el siguiente número libre (por antigüedad)
    ./lab --lab <nombre> plan       ORDENA y muestra las llamadas REST que haría
    ./lab --lab <nombre> preflight  sólo lectura: qué hay, qué falta, qué difiere
    ./lab --lab <nombre> apply      converge lo declarado + verifica
    ./lab --lab <nombre> verify     TEST FINAL: ¿existe de verdad lo declarado?
    ./lab --lab <nombre> test       lanza las PRUEBAS FUNCIONALES que declara el lab
                                    (¿hace lo que dice que hace? ping, servicio, dns);
    ./lab --lab <nombre> capture    mira el tráfico de un bridge desde el bastión
                                    (lo declarado en `capture:` → logs/captura-*.txt)
    ./lab --lab <nombre> impair     estropea un bridge (retardo/pérdida) desde el
                                    bastión y lo apaga solo (`impairment:`)
    ./lab --lab <nombre> destroy    único verbo que destruye; pide confirmación
    ./lab check [nombre]            checks del motor, sin credenciales ni Proxmox
                                    (`version` es del repositorio: VERSION, tag y
                                    CHANGELOG tienen que contar lo mismo -- ADR 0017)

Opciones:
    --api        en `plan`, leer el estado del mundo de la API en vez del fixture
    --yes        en `destroy`, no pedir confirmación interactiva
    --actualizar en `check docs`, reescribir la región generada de cada documento
    --sellar <doc> en `check docs`, sellar un documento tras revisar su prosa

Se ejecuta desde cualquier sitio: el wrapper se coloca en la raíz del repositorio,
que es donde Ansible busca ansible.cfg.
"""


def fallo(mensaje):
    print(f"\n./lab: {mensaje}\n", file=sys.stderr)
    return 2


def ruta_ansible_playbook():
    """Dónde está `ansible-playbook`. En el PATH o en el sitio habitual de usuario."""
    encontrado = shutil.which("ansible-playbook")
    if encontrado:
        return encontrado
    candidato = os.path.expanduser("~/.local/bin/ansible-playbook")
    if os.path.exists(candidato):
        return candidato
    return None


def labs_declarados():
    """Una carpeta con `<carpeta>.yml` dentro. Los nombres con punto (`.plantilla`)
    no son labs."""
    if not os.path.isdir(DIRECTORIO_LABS):
        return []
    labs = []
    for nombre in sorted(os.listdir(DIRECTORIO_LABS)):
        ruta = os.path.join(DIRECTORIO_LABS, nombre)
        if nombre.startswith(".") or not os.path.isdir(ruta):
            continue
        if os.path.exists(os.path.join(ruta, f"{nombre}.yml")):
            labs.append(nombre)
    return labs


def comprobar_entorno():
    """Lo que tiene que estar en pie ANTES de lanzar Ansible. Falla pronto y claro."""
    if not os.path.exists(os.path.join(RAIZ, "ansible.cfg")):
        return "falta ansible.cfg en la raíz del repositorio"
    if ruta_ansible_playbook() is None:
        return "no encuentro `ansible-playbook` (¿está en el PATH o en ~/.local/bin?)"
    return None


def descifrar_secretos():
    """Si hay `secrets.sops.yml` y no hay un `secrets.yml` al día, lo descifra en claro.

    Devuelve None cuando no hay nada que hacer (o cuando todo fue bien) o un mensaje de
    error. Es la puerta del informe §6.6: los secretos pueden vivir CIFRADOS y
    versionados, y el wrapper (que es el único punto de entrada) los deja en el mismo
    `secrets.yml` gitignored que ya espera el motor -- así no cambia ni una tarea.

    NO exporta ninguna variable de entorno: la clave se pasa a sops con `--age-key-file`,
    que es una BANDERA y no una variable, así que el motor sigue sin leer `os.environ`
    (regla 4.4). La clave privada (`deployment_engine/age.key`) vive en modo 0600 y no se
    versiona; lo que se versiona es el fichero cifrado.
    """
    if not os.path.exists(SECRETS_CIFRADOS):
        return None
    # Un `secrets.yml` en claro más nuevo que el cifrado MANDA: es el caso de "lo edité a
    # mano hace un momento" y no se pisa con algo más viejo.
    if os.path.exists(SECRETS) and os.path.getmtime(SECRETS) >= os.path.getmtime(SECRETS_CIFRADOS):
        return None
    sops = shutil.which("sops")
    if sops is None:
        return ("hay deployment_engine/secrets.sops.yml pero no encuentro el binario "
                "`sops`: instálalo (https://github.com/getsops/sops) o descifra a mano a "
                "deployment_engine/secrets.yml")
    if not os.path.exists(CLAVE_AGE):
        return (f"hay deployment_engine/secrets.sops.yml pero falta la clave privada "
                f"{os.path.relpath(CLAVE_AGE, RAIZ)} (modo 0600; no se versiona)")
    orden = [
        sops, "--decrypt", "--input-type", "yaml", "--output-type", "yaml",
        "--age-key-file", CLAVE_AGE, "--output", SECRETS, SECRETS_CIFRADOS,
    ]
    proceso = subprocess.run(orden, cwd=RAIZ, capture_output=True, text=True, check=False)
    if proceso.returncode != 0:
        # El error de sops puede nombrar la clave, pero no su valor; se enseña tal cual.
        detalle = (proceso.stderr or proceso.stdout or "").strip().splitlines()
        return ("sops no pudo descifrar deployment_engine/secrets.sops.yml"
                + (": " + detalle[-1] if detalle else ""))
    os.chmod(SECRETS, 0o600)
    print("credenciales: descifradas de deployment_engine/secrets.sops.yml a "
          "deployment_engine/secrets.yml (0600)")
    return None


def orden_list():
    labs = labs_declarados()
    if not labs:
        print("No hay ningún lab declarado en labs/ (créalo con `./lab new <nombre>`).")
        return 0
    print(f"Labs declarados en labs/ ({len(labs)}):")
    for lab in labs:
        carpeta = os.path.join(DIRECTORIO_LABS, lab)
        tiene_doc = "sí" if os.path.exists(os.path.join(carpeta, f"{lab}.md")) else "NO"
        tiene_logs = "sí" if os.path.isdir(os.path.join(carpeta, "logs")) else "NO"
        print(f"  - {lab:<24} documento={tiene_doc:<3} logs/={tiene_logs}")
    return 0


def siguiente_numero_libre():
    """El número que le toca al siguiente lab.

    Los labs se numeran por ANTIGÜEDAD y la carpeta lo lleva delante (`01_`, `02_`…), así
    que el número no se inventa: es el mayor que ya hay, más uno. Se mira el mayor y no la
    cuenta a propósito -- si un lab se renombra o su carpeta desaparece, su número no se
    reutiliza y el orden histórico no se falsea.
    """
    usados = []
    for lab in labs_declarados():
        coincidencia = re.match(r"^(\d+)_", lab)
        if coincidencia:
            usados.append(int(coincidencia.group(1)))
    return (max(usados) + 1) if usados else 1


def orden_new(nombre):
    # El número va DELANTE y lo pone el wrapper, porque el prefijo es una propiedad del
    # REPOSITORIO (el orden de antigüedad, para que `ls labs/` se lea de arriba abajo) y no
    # del lab que se está creando. Se puede pedir uno concreto escribiéndolo (`./lab new
    # 07_lo-que-sea`), y si no, se toma el siguiente libre: así dos labs nunca comparten
    # prefijo, aunque uno se cree entre medias de otros dos.
    base = nombre or ""
    numero_pedido = None
    coincidencia = re.match(r"^(\d+)_(.+)$", base)
    if coincidencia:
        numero_pedido, base = int(coincidencia.group(1)), coincidencia.group(2)
    if not base or not all(c.isalnum() or c == "-" for c in base) or base != base.lower():
        return fallo(
            f"nombre de lab inválido: {nombre!r} (minúsculas, dígitos y guiones; "
            "el prefijo numérico lo pone el wrapper)"
        )

    numero = numero_pedido if numero_pedido is not None else siguiente_numero_libre()
    nombre = f"{numero:02d}_{base}"
    destino = os.path.join(DIRECTORIO_LABS, nombre)
    if os.path.exists(destino):
        return fallo(f"labs/{nombre} ya existe")
    if not os.path.isdir(PLANTILLA):
        return fallo("falta labs/.plantilla/")

    os.makedirs(os.path.join(destino, "logs"), exist_ok=True)
    # El bridge del esqueleto se DERIVA del nombre del lab, y no se copia tal cual:
    # una interfaz del kernel no admite guiones ni pasa de 15 caracteres
    # (IFNAMSIZ), y un nombre de lab como `mi-sitio-1` los lleva sin ningún
    # problema. Si el esqueleto nace con un bridge que Proxmox rechazaría,
    # `.plantilla/` está fuera de los checks (empieza por punto) y el fallo no se
    # ve hasta que el humano rellena el YAML: por eso la derivación vive aquí y no
    # en la plantilla.
    bridge = ("vmb_" + nombre.replace("-", "_"))[:15].rstrip("_")
    for origen in sorted(os.listdir(PLANTILLA)):
        extension = os.path.splitext(origen)[1]
        destino_fichero = os.path.join(destino, f"{nombre}{extension}")
        with open(os.path.join(PLANTILLA, origen), encoding="utf-8") as fichero:
            contenido = fichero.read()
        with open(destino_fichero, "w", encoding="utf-8") as fichero:
            fichero.write(
                contenido.replace("<NOMBRE_BRIDGE>", bridge).replace("<NOMBRE>", nombre)
            )
    # `.gitkeep` para que la carpeta de logs exista en el clon, sin versionar los logs.
    with open(os.path.join(destino, "logs", ".gitkeep"), "w", encoding="utf-8") as fichero:
        fichero.write("")

    print(f"labs/{nombre}/ creado desde labs/.plantilla/")
    print("Dos cosas que el esqueleto NO puede decidir por ti:")
    print("  · el `tipo:` de cada invitado (`rt`/`srv`/`ws`/`sw`/`ctl`): el nombre en Proxmox")
    print("    dice qué EQUIPO es, no de qué lab es (`rt-borde`, `srv-1`) -- ADR 0015")
    print("  · su alias, si no quieres que sea el rol (`nombre: 2` -> `ws-2`)")
    print("Siguiente paso:")
    print(f"  1. rellena labs/{nombre}/{nombre}.yml (roles, bridges, direcciones y etapas)")
    print(f"  2. ./lab --lab {nombre} plan")
    print(f"  3. ./lab check docs --actualizar   (regenera la parte de datos del documento)")
    return 0


def ejecutar_verbo(lab, verbo, opciones):
    """Valida el lab y lanza el playbook del verbo, con la salida a logs/ansible.log."""
    carpeta = os.path.join(DIRECTORIO_LABS, lab)
    declaracion = os.path.join(carpeta, f"{lab}.yml")
    logs = os.path.join(carpeta, "logs")

    if not os.path.isdir(carpeta):
        return fallo(f"no existe labs/{lab} (míralo con `./lab list`)")
    if not os.path.exists(declaracion):
        return fallo(f"falta la declaración labs/{lab}/{lab}.yml")
    if not os.path.isdir(logs):
        return fallo(
            f"falta labs/{lab}/logs/ (es el directorio donde van el diario de API y los "
            f"informes; créalo con `mkdir -p labs/{lab}/logs`)"
        )

    usa_api = verbo in VERBOS_CON_API or "--api" in opciones
    # Si las credenciales están cifradas, se descifran aquí. Es el único punto por el que
    # pasa todo verbo, así que el motor no cambia nada (§6.6). SÓLO cuando el verbo va a
    # hablar con la API: `plan` sin `--api` planifica contra un fixture y no necesita
    # credenciales, así que un clon que trae `secrets.sops.yml` versionado pero no tiene
    # `sops` ni la clave de age (o no quiere tenerlos) tiene que poder seguir usándolo.
    if usa_api:
        error_credenciales = descifrar_secretos()
        if error_credenciales:
            return fallo(error_credenciales)
    if usa_api and not os.path.exists(SECRETS):
        return fallo(
            "faltan las credenciales: crea deployment_engine/secrets.yml a mano, dale "
            "modo 0600 y rellénalo (las claves están en el README, §«Las credenciales "
            "se escriben a mano»).\n"
            "            (El verbo 'plan' sin --api no las necesita: usa un fixture.)"
        )

    if verbo == "destroy" and "--yes" not in opciones:
        print(f"Vas a DESTRUIR el lab '{lab}': sus invitados y su pool en Proxmox.")
        print("Es irreversible y no se puede deshacer desde este repositorio.")
        respuesta = input(f"Escribe el nombre del lab para confirmar ({lab}): ").strip()
        if respuesta != lab:
            return fallo("confirmación incorrecta: no se ha destruido nada")

    entorno = comprobar_entorno()
    if entorno:
        return fallo(entorno)

    orden = [ruta_ansible_playbook(), os.path.join(PLAYBOOKS, f"{verbo}.yml")]
    orden += ["-e", f"pve_lab={lab}"]
    orden += ["-e", f"pve_archivo_lab={declaracion}"]
    orden += ["-e", f"pve_carpeta_logs={logs}"]
    orden += ["-e", f"pve_verb={verbo}"]
    if os.path.exists(SECRETS):
        orden += ["-e", f"@{SECRETS}"]
    # `plan` sin --api: el estado del mundo es un clúster vacío simulado. Es lo que
    # hace el plan demostrable sin credenciales, y se dice en la salida.
    if verbo == "plan" and "--api" not in opciones:
        orden += ["-e", f"pve_estado_fixture={FIXTURE_VACIO}"]

    titulo = f"=== ./lab --lab {lab} {verbo} · {time.strftime('%Y-%m-%d %H:%M:%S')} ==="
    print(titulo)
    print(f"log: {os.path.relpath(os.path.join(logs, 'ansible.log'), RAIZ)}")
    print()

    inicio = time.time()
    proceso = subprocess.Popen(
        orden, cwd=RAIZ, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1
    )
    with open(os.path.join(logs, "ansible.log"), "a", encoding="utf-8") as registro:
        registro.write(f"\n{titulo}\n")
        for linea in proceso.stdout:
            sys.stdout.write(linea)
            registro.write(linea)
    codigo = proceso.wait()

    # El resumen lo escribe el playbook (no Ansible): en la salida de Ansible un texto
    # multilínea sale escapado y es ilegible, así que el playbook deja el texto en un
    # fichero y el wrapper lo imprime tal cual.
    nombre_resumen = RESUMEN_DE.get(verbo)
    if nombre_resumen:
        ruta_resumen = os.path.join(logs, nombre_resumen)
        if os.path.exists(ruta_resumen) and os.path.getmtime(ruta_resumen) >= inicio:
            print()
            with open(ruta_resumen, encoding="utf-8") as fichero:
                print(fichero.read().rstrip("\n"))

    # El resumen de la pasada se rehace SIEMPRE, aunque el verbo haya fallado: un diario a
    # medias es justo cuando hace falta saber qué pasó y sobre qué equipo. Lo escribe
    # deployment_engine/tools/resumen.py, que sólo LEE (no habla con nadie, no toca el
    # mundo), y se llama como herramienta, no como verbo: no está en VERBOS ni en la ayuda.
    try:
        import importlib.util
        ruta_herramienta = os.path.join(RAIZ, "deployment_engine", "tools", "resumen.py")
        especificacion = importlib.util.spec_from_file_location("resumen_del_lab", ruta_herramienta)
        modulo = importlib.util.module_from_spec(especificacion)
        especificacion.loader.exec_module(modulo)
        texto, _ = modulo.resumen_de_lab(logs, verbo)
        ruta_informe = os.path.join(logs, "resumen.md")
        with open(ruta_informe, "w", encoding="utf-8") as fichero:
            fichero.write(texto + "\n")
        print(f"\nel resumen de la pasada: {os.path.relpath(ruta_informe, RAIZ)}")
    except Exception as error:
        # Un resumen que revienta no puede tumbar un despliegue que fue bien.
        print(f"\n(no he podido escribir el resumen: {error})")
    return codigo


def version_declarada():
    """La versión publicada según el fichero `VERSION`, o None si no hay fichero."""
    if not os.path.exists(FICHERO_VERSION):
        return None
    with open(FICHERO_VERSION, encoding="utf-8") as fichero:
        return fichero.read().strip()


def ultimo_tag():
    """El tag `vX.Y.Z` más alto de este clon, o None si no hay ninguno.

    `--sort=-v:refname` ordena por versión, no por fecha: publicar 0.10.0 después de
    0.9.0 tiene que dar 0.10.0, y alfabéticamente daría 0.9.0.
    """
    try:
        salida = subprocess.run(
            ["git", "tag", "--list", "v[0-9]*", "--sort=-v:refname"],
            cwd=RAIZ, capture_output=True, text=True, check=False,
        )
    except OSError:
        return None
    lineas = [linea for linea in salida.stdout.split() if linea]
    return lineas[0] if lineas else None


def entradas_del_changelog():
    """{versión: fecha} de las cabeceras `## [X.Y.Z] - AAAA-MM-DD` del CHANGELOG."""
    if not os.path.exists(FICHERO_CHANGELOG):
        return {}
    with open(FICHERO_CHANGELOG, encoding="utf-8") as fichero:
        texto = fichero.read()
    return dict(EXPRESION_ENTRADA_CHANGELOG.findall(texto))


def comprobar_version():
    """Check `version`: la versión publicada, en los tres sitios, tiene que ser la misma.

    Un check que no puede fallar no es un check: se ha visto fallar (a propósito) sin
    `VERSION`, con un `VERSION` que no es `MAYOR.MENOR.PARCHE`, sin la entrada del
    CHANGELOG y con un tag que no coincide con el fichero.
    """
    fallos = []
    version = version_declarada()
    if version is None:
        fallos.append(
            "no hay fichero VERSION en la raíz: lleva la última versión publicada "
            "(una línea, p.ej. `0.1.0`) -- ADR 0017"
        )
    elif not EXPRESION_VERSION.match(version):
        fallos.append(f"VERSION dice `{version}`, que no es `MAYOR.MENOR.PARCHE`")

    entradas = entradas_del_changelog()
    if not entradas:
        fallos.append(
            "CHANGELOG.md no tiene ninguna entrada `## [X.Y.Z] - AAAA-MM-DD`: "
            "toda versión publicada cuenta lo que cambió"
        )
    elif version and version not in entradas:
        fallos.append(
            f"VERSION dice `{version}` y el CHANGELOG no tiene su entrada "
            f"(`## [{version}] - AAAA-MM-DD`)"
        )

    tag = ultimo_tag()
    if tag and version and tag != f"v{version}":
        fallos.append(
            f"el último tag es `{tag}` y VERSION dice `{version}`: o se publicó el tag "
            f"sin subir VERSION, o se subió VERSION sin publicar"
        )

    if fallos:
        print("FALLA version: la versión publicada no es una sola cosa:")
        for fallo in fallos:
            print(f"  - {fallo}")
        return 1
    if tag:
        print(f"OK    version: la versión publicada es la {version}, y su tag `{tag}` está")
    else:
        print(f"OK    version: VERSION dice {version} y el CHANGELOG la cuenta "
              f"(todavía sin ningún tag: la primera publicación está pendiente)")
    return 0


def orden_version():
    """`./lab version`: la versión publicada y el último tag, en una línea cada uno."""
    version = version_declarada()
    tag = ultimo_tag()
    if version is None:
        return fallo("no hay fichero VERSION en la raíz: no sé qué versión es ésta")
    print(f"versión publicada: {version}  (fichero VERSION)")
    if tag is None:
        print("último tag:        (ninguno: esta versión todavía no se ha publicado)")
    elif tag == f"v{version}":
        print(f"último tag:        {tag}  (coincide: este es el estado publicado)")
    else:
        print(f"último tag:        {tag}  (NO coincide con VERSION: ./lab check version)")
    return 0


def orden_check(argumentos):
    if not os.path.exists(CHECKS):
        return fallo("falta deployment_engine/tools/framework_check.py")
    # `version` es del repositorio, no del motor, así que corre aquí y no en la
    # herramienta de checks; cuando se piden TODOS, se corre junto a ellos.
    if not argumentos or argumentos[0] == "version":
        codigo = comprobar_version()
        sys.stdout.flush()  # que el veredicto salga ANTES del de los checks del motor
        if argumentos:
            return codigo
        return max(codigo, subprocess.call([sys.executable, CHECKS], cwd=RAIZ))
    return subprocess.call([sys.executable, CHECKS, *argumentos], cwd=RAIZ)


def main(argumentos):
    if not argumentos or argumentos[0] in ("-h", "--help", "help"):
        print(AYUDA)
        return 0 if argumentos else 2
    if argumentos[0] == "version":
        return orden_version()
    if argumentos[0] == "list":
        return orden_list()
    if argumentos[0] == "new":
        return orden_new(argumentos[1] if len(argumentos) > 1 else None)
    if argumentos[0] == "check":
        return orden_check(argumentos[1:])

    if argumentos[0] != "--lab":
        return fallo(f"no entiendo `{argumentos[0]}` (prueba `./lab --help`)")
    if len(argumentos) < 3:
        return fallo("--lab necesita un nombre de lab y un verbo")

    lab = argumentos[1]
    verbo = argumentos[2]
    opciones = argumentos[3:]
    if verbo not in VERBOS:
        return fallo(f"verbo desconocido: {verbo}. Los que hay: {', '.join(VERBOS)}")
    return ejecutar_verbo(lab, verbo, opciones)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
